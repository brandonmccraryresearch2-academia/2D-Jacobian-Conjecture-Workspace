// Leg D: lift certificates for the two extra §6 identities.
// Ideal I = the 9 equations (D2_1..D2_5, D2_7, Q1, Q2, 2*Q4 — doubled Q4
// so no fractions appear; matches the Lean certificate generators).
// Targets: T1 = 3*dm1^2*dm2 - y^9, T2 = 2*dm3*y^9 - 3*d0*dm1^4.
// If T2 is not in I, also try dm2*T2 (divide by dm2 afterwards in the
// domain, using dm2 != 0 from T1 + y != 0 + dm1 != 0).
// Singular 4.3.1, char 0.
ring R = 0, (d0,d1,dm1,dm2,dm3,dm4,dm5,dm6,dm7,dm8,dm10,y), dp;
poly D2_1 = 2*d0*dm1 + 2*d1*dm2 + 2*dm4;
poly D2_2 = dm1^2 + 2*d0*dm2 + 2*d1*dm3 + 2*dm5;
poly D2_3 = 2*dm1*dm2 + 2*d0*dm3 + 2*d1*dm4 + 2*dm6;
poly D2_4 = dm2^2 + 2*dm1*dm3 + 2*d0*dm4 + 2*d1*dm5 + 2*dm7;
poly D2_5 = 2*dm2*dm3 + 2*dm1*dm4 + 2*d0*dm5 + 2*d1*dm6 + 2*dm8;
poly D2_7 = 2*dm10 + 2*dm3*dm4 + 2*dm2*dm5 + 2*dm1*dm6 + 2*d0*dm7 + 2*d1*dm8;
poly Q1 = 3*d0^2*dm1 + 3*d1*dm1^2 + 6*d0*d1*dm2 + 3*dm2^2 + 3*d1^2*dm3 + 6*dm1*dm3 + 6*d0*dm4 + 6*d1*dm5 + 3*dm7;
poly Q2 = 3*d0*dm1^2 + 3*d0^2*dm2 + 6*d1*dm1*dm2 + 6*d0*d1*dm3 + 6*dm2*dm3 + 3*d1^2*dm4 + 6*dm1*dm4 + 6*d0*dm5 + 6*d1*dm6 + 3*dm8;
poly Q4x2 = 6*dm10 + 6*dm1^2*dm2 + 6*d0*dm2^2 + 12*d0*dm1*dm3 + 12*d1*dm2*dm3 + 6*d0^2*dm4 + 12*d1*dm1*dm4 + 12*dm3*dm4 + 12*d0*d1*dm5 + 12*dm2*dm5 + 6*d1^2*dm6 + 12*dm1*dm6 + 12*d0*dm7 + 12*d1*dm8 + y^9;
ideal I = D2_1, D2_2, D2_3, D2_4, D2_5, D2_7, Q1, Q2, Q4x2;
poly T1 = 3*dm1^2*dm2 - y^9;
poly T2 = 2*dm3*y^9 - 3*d0*dm1^4;
print("reduce(T1,I) ="); print(reduce(T1, I));
print("reduce(T2,I) ="); print(reduce(T2, I));
print("reduce(dm2*T2,I) ="); print(reduce(dm2*T2, I));
matrix L1 = lift(I, T1);
print("L1 (coeffs for T1, order D2_1 D2_2 D2_3 D2_4 D2_5 D2_7 Q1 Q2 Q4x2) =");
print(L1);
matrix L2 = lift(I, T2);
print("L2 (coeffs for T2) =");
print(L2);
matrix L2b = lift(I, dm2*T2);
print("L2b (coeffs for dm2*T2) =");
print(L2b);
quit;
