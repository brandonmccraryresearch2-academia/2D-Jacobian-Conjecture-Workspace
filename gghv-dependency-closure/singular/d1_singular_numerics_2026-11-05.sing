ring R = 0, (x), dp;
print("=== S3-84: I_M = 7*(4*(1/7)) (expect 4) ===");
print(7*(4*(1/7)));
print("=== S3-84: I_m = 1-((-3+1)+7*(-9/7+1)) (expect 5) ===");
print(1-((-3+1)+7*(-9/7+1)));
