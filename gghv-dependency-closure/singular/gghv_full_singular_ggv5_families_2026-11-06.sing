// Leg G, Phase 4 — R22: [GGV5] enumeration, GENERATIVE use + family-to-row
// attribution, recomputed in Singular (I1).
// Filed precedent recomputed only the first-stage PLLC filter
// (singular/d1_singular_pllc_2026-11-05.sing: pllcFilter(8,3)=1,
// pllcFilter(8,4)=0). This script implements [GGV5] Algorithm GetmnFamilies
// (arXiv:1708.07936, §5) in Singular and runs it on the final corners of
// the families used by GGHV §2, then attributes each GGHV §2 row to its
// family and parameter j, verifying (m,n) and the max-degree formula.
// Cross-check: gghv_full_singular_ggv5_families_py_2026-11-06.py (Python
// exact ints + python-flint), an independent implementation.
// Status: I1 only, never a proof / kernel verification. Singular 4.3.1.
//
// Delimitation (see leg log): this recomputes the GENERATIVE step (families
// from a given final corner) and the ARITHMETIC attribution (row -> family,
// j, max degree). It does NOT recompute the Main-algorithm chain enumeration
// (which final corners / chains exist with v11(A0) <= 35) or the completeness
// claim that the listed families/chains are ALL — those rest on the [GGV5]
// C++ program + SQL database, which are not available as a Singular
// computation. Completeness stays NOT recomputed.

ring R = 0, (t), dp;

// BezoutCoefficients(x,y): smallest positive N with (1+N*y) divisible by x;
// returns list(M,N) with M*x - N*y = 1, M > 0, N > 0 minimal.
// Assumes gcd(x,y) = 1, x,y > 0. Returns list(0,0) on failure.
proc bezoutCoeff(int x, int y)
{
  int N; int M;
  for (N = 1; N <= 5000; N++)
  {
    if ((1 + N*y) % x == 0)
    {
      M = (1 + N*y) div x;
      if (M > 0) { return(list(M, N)); }
    }
  }
  return(list(0,0));
}

// GetmnFamilies(a,l,b) for a final corner A = (a/l, b), a,l,b positive ints.
// Returns a list of list((k,i),(m,n),(D1,D2)): the (m,n)-families
// MN_ki(A) = {(m + j*D1, n + j*D2) : j in N0}.
// Follows [GGV5] Algorithm GetmnFamilies verbatim, including the
// m=1-or-n=1 shift and the kbar>1 sub-family loop.
proc getmnFamilies(int a, int l, int b)
{
  list F;
  int bl = b*l - a;
  int kmax = (bl + b - 1) div b - 1;   // ceil(l - a/b) - 1
  int k; int e; int q; int M; int N; int m; int n; int D1; int D2;
  int kbar; int i; int mi; int ni; list BN;
  for (k = 1; k <= kmax; k++)
  {
    e = gcd(k, bl);
    q = bl div e;
    if (gcd(b, q) == 1)
    {
      BN = bezoutCoeff(b, q);
      M = BN[1]; N = BN[2];
      n = (N*k) div e;
      m = M - n;
      D1 = (bl - b*k) div e;
      D2 = (b*k) div e;
      if ((m == 1) || (n == 1)) { m = m + D1; n = n + D2; }
      kbar = k div e;
      if (kbar == 1)
      {
        F = F + list(list(list(k,0), list(m,n), list(D1,D2)));
      }
      else
      {
        for (i = 0; i <= kbar-1; i++)
        {
          mi = m + i*D1; ni = n + i*D2;
          if (gcd(mi,ni) == 1)
          {
            F = F + list(list(list(k,i), list(mi,ni), list(kbar*D1, kbar*D2)));
          }
        }
      }
    }
  }
  return(F);
}

// checkFam(F, k, i, m, n, D1, D2, label): 1 if F contains exactly that
// family triple (and prints it), else 0.
proc checkFam(list F, int k, int i, int m, int n, int D1, int D2)
{
  int j; int found;
  found = 0;
  for (j = 1; j <= size(F); j++)
  {
    if ((F[j][1][1] == k) && (F[j][1][2] == i)
        && (F[j][2][1] == m) && (F[j][2][2] == n)
        && (F[j][3][1] == D1) && (F[j][3][2] == D2)) { found = 1; }
  }
  return(found);
}

print("=== R22: GetmnFamilies on the [GGV5] §5 final corners ===");
print("--- F1: A1 = (7/4, 3); table: k=1, (m,n) = (3+2j, 4+3j) ---");
list F1 = getmnFamilies(7,4,3);
print("F1_FAMILIES:");
print(F1);
print("F1_CHECK (expect 1):");
print(checkFam(F1, 1, 0, 3, 4, 2, 3));
print("F1_SIZE (expect 1):");
print(size(F1));

