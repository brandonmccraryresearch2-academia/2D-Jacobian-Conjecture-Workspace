print("=== R22: family-to-row attribution for the GGHV §2 table ===");
// For each §5-family row: (family base (m0,n0), step (D1,D2), j, A0, maxdeg).
// Check (m,n) = (m0 + j*D1, n0 + j*D2), gcd(m,n) = 1, maxdeg = max(m,n)*(a0+b0).
print("ROW1 F1 j=0 (3,4) A0=(4,12) max 64:");
