// Leg D: lift certificate for the E18 square identity in K[X].
// Ring variables: d0,d1,dm1,dm2,dm3,dm4,dm5,dm6,dm7,dm8,dm10,y,al,lm
// (al = alpha, lm = lambda).
// Ideal J = (principal S1, extra identities S2, S3, monomial form S4,
// final combination S5). Target T = (27 al^9 d0 - 2 y^9)^2
// - 108 al^10 (al^3 y^8 - 2 lm y^10).
// If T is not in J, try y^2*al^10*T (the multiplier from the field
// derivation) and y^9*T; in Lean, a nonzero scalar factor (y^2 al^10,
// with y != 0, al != 0) can be cancelled in the domain K[X].
// Singular 4.3.1, char 0. NOTE: this Groebner computation may be slow;
// if it does not finish, fall back to the RatFunc transfer of
// square_identity_field.
ring R = 0, (d0,d1,dm1,dm2,dm3,dm4,dm5,dm6,dm7,dm8,dm10,y,al,lm), dp;
poly S1 = 9*y^9*d1*dm1^6 + y^27 + 27*d0*dm1^9;
poly S2 = 3*dm1^2*dm2 - y^9;
poly S3 = 2*dm3*y^9 - 3*d0*dm1^4;
poly S4 = dm1 - al*y^2;
poly S5 = -dm1^3 - 6*d0*dm1*dm2 - 3*d1*dm2^2 + 3*dm3^2 + 2*lm*y^8;
ideal J = S1, S2, S3, S4, S5;
poly T = (27*al^9*d0 - 2*y^9)^2 - 108*al^10*(al^3*y^8 - 2*lm*y^10);
print("reduce(T,J) ="); print(reduce(T, J));
print("reduce(y^2*al^10*T,J) ="); print(reduce(y^2*al^10*T, J));
print("reduce(y^9*T,J) ="); print(reduce(y^9*T, J));
matrix LT = lift(J, T);
print("LT (coeffs for T, order S1 S2 S3 S4 S5) =");
print(LT);
matrix LT2 = lift(J, y^2*al^10*T);
print("LT2 (coeffs for y^2*al^10*T) =");
print(LT2);
quit;
