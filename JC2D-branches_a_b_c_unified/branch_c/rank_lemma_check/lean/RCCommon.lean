/-!
# Branch (c): packed kernel check of C * M_S = I (mod 32003), C = M_S⁻¹

Generated by `branch_c/rank_lemma_check/gen_lean.py`. A vector `v ∈ 𝔽_p^3199` is packed into `∑ k, v k * 2 ^ (40 * k)`.
`Cpk_i` packs column `i` of `C`. `slotOK x`: every slot of `x` is `< 2 ^ 15` and `x < 2 ^ (40 * 3199)`.
`colOK j X`: `X = 32003 * Q + 2 ^ (40 * j)` with every slot of `Q` `< 2 ^ 22`.
With at most 52 terms and coefficients `< 32003`, no slot carries, so `colOK j (∑ t, v t * Cpk (i t))` and `slotOK` of
each `Cpk (i t)` give `∑ t, v t * C[k, i t] ≡ δ k j [MOD 32003]` for every `k`. That implication is not formalized here;
the theorems are identities between natural numbers, checked by the kernel (`decide +kernel`, no `native_decide`).
-/

namespace BranchC.RankCheck

/-- big-endian chunks of 8192 bits -/
def ofChunks (l : List Nat) : Nat := l.foldl (fun acc c => (acc <<< 8192) ||| c) 0

/-- bits 22..39 of every slot -/
def maskQ : Nat := (2 ^ 40 - 2 ^ 22) * ((2 ^ (40 * 3199) - 1) / (2 ^ 40 - 1))

/-- bits 15..39 of every slot -/
def maskC : Nat := (2 ^ 40 - 2 ^ 15) * ((2 ^ (40 * 3199) - 1) / (2 ^ 40 - 1))

/-- `X = 32003 * Q + 2 ^ (40 * j)` with every slot of `Q` below `2 ^ 22` -/
def colOK (j X : Nat) : Bool :=
  let E := 2 ^ (40 * j)
  let Q := (X - E) / 32003
  (32003 * Q + E == X) && (Q &&& maskQ == 0)

/-- every slot below `2 ^ 15`, and no slot beyond the 3199th -/
def slotOK (x : Nat) : Bool := (x &&& maskC == 0) && (x >>> (40 * 3199) == 0)

end BranchC.RankCheck
