/-- Every column passes its deduped union-tuple check and its link. -/
theorem colCheckAll (c : Fin 3199) :
    (dedup5 (unionTuples c)).all (checkFun c) = true ∧ linkFun c = true := by
  by_cases h0 : c.val < 10
  ·
    have hlo : 0 ≤ c.val := Nat.zero_le _
    have hj : c.val - 0 < 10 := Nat.sub_lt_left_of_lt_add hlo h0
    have hck := colCheckChunk0 (c.val - 0) hj
    have hval : 0 + (c.val - 0) = c.val := Nat.add_sub_cancel' hlo
    have hce : (⟨0 + (c.val - 0), Nat.lt_trans (Nat.add_lt_add_left hj 0) boundChunk0⟩ : Fin 3199) = c := Fin.ext hval
    rw [hce] at hck
    exact hck
  ·
    by_cases h1 : c.val < 20
    ·
      have hlo : 10 ≤ c.val := Nat.not_lt.mp h0
      have hj : c.val - 10 < 10 := Nat.sub_lt_left_of_lt_add hlo h1
      have hck := colCheckChunk1 (c.val - 10) hj
      have hval : 10 + (c.val - 10) = c.val := Nat.add_sub_cancel' hlo
      have hce : (⟨10 + (c.val - 10), Nat.lt_trans (Nat.add_lt_add_left hj 10) boundChunk1⟩ : Fin 3199) = c := Fin.ext hval
      rw [hce] at hck
      exact hck
    ·
      by_cases h2 : c.val < 30
      ·
        have hlo : 20 ≤ c.val := Nat.not_lt.mp h1
