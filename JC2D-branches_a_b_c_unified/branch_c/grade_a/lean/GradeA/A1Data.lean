/- A1 data: pivot-column lists of M_S, as Lean list lookups.

    Generated by `rank_lemma_check/emit_a1data.py` from the kept
    `INVERSE.pkl` (build_matrix + make_inverse, p = 32003).
    - `colDataNat j` is colv[j]: the (row, value) entries of pivot
      column j of M_S (at most 52 entries, values < 32003, rows < 3199).
    - `CpkFunNat i` is Cpk_i for i < 3199 (0 otherwise), so the packed
      columns of C are available as a function of the row index.
    - `XSumNat j` is the col_j sum in exactly the form of the RCCheck
      `col_j` statements (verified textually against all 3199 of them).
    Split into A1Data00..07 (400 columns each): a single 3.5 MB file
    was killed (OOM) during elaboration on this VM.
-/

import A1Data00
import A1Data01
import A1Data02
import A1Data03
import A1Data04
import A1Data05
import A1Data06
import A1Data07

namespace BranchC.A1Data

def colDataNat (j : Nat) : List (Nat × Nat) :=
  if j < 400 then colDataPart0.getD (j - 0) [] else
  if j < 800 then colDataPart1.getD (j - 400) [] else
  if j < 1200 then colDataPart2.getD (j - 800) [] else
  if j < 1600 then colDataPart3.getD (j - 1200) [] else
  if j < 2000 then colDataPart4.getD (j - 1600) [] else
  if j < 2400 then colDataPart5.getD (j - 2000) [] else
  if j < 2800 then colDataPart6.getD (j - 2400) [] else
  colDataPart7.getD (j - 2800) []

noncomputable def CpkFunNat (j : Nat) : Nat :=
  if j < 400 then cpkPart0.getD (j - 0) 0 else
  if j < 800 then cpkPart1.getD (j - 400) 0 else
  if j < 1200 then cpkPart2.getD (j - 800) 0 else
  if j < 1600 then cpkPart3.getD (j - 1200) 0 else
  if j < 2000 then cpkPart4.getD (j - 1600) 0 else
  if j < 2400 then cpkPart5.getD (j - 2000) 0 else
  if j < 2800 then cpkPart6.getD (j - 2400) 0 else
  cpkPart7.getD (j - 2800) 0

noncomputable def XSumNat (j : Nat) : Nat :=
  if j < 400 then xsumPart0.getD (j - 0) 0 else
  if j < 800 then xsumPart1.getD (j - 400) 0 else
  if j < 1200 then xsumPart2.getD (j - 800) 0 else
  if j < 1600 then xsumPart3.getD (j - 1200) 0 else
  if j < 2000 then xsumPart4.getD (j - 1600) 0 else
  if j < 2400 then xsumPart5.getD (j - 2000) 0 else
  if j < 2800 then xsumPart6.getD (j - 2400) 0 else
  xsumPart7.getD (j - 2800) 0

end BranchC.A1Data
